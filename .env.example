# Copy to .env / .env.local. Do not commit secret values.
# Never prefix SUPABASE_SERVICE_ROLE_KEY with VITE_.
#
# On Vercel, set the same URL and publishable key twice: VITE_* (build-time
# client bundle) and unprefixed (server/SSR runtime). Production and Preview.

SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Canonical public origin for table QR codes (build-time). Example: https://your-app.vercel.app
VITE_PUBLIC_APP_URL=
# Optional. Extra origin allowed when scanning QR codes on preview deployments.
VITE_PUBLIC_PREVIEW_URL=

# Server-only. Required for admin, onboarding, POS, inventory, booking, and most server functions.
# Must not be VITE_ prefixed. Mark Sensitive on Vercel; runtime only.
SUPABASE_SERVICE_ROLE_KEY=

# drizzle-kit only. Direct Postgres URL; not used by the Vite app or Vercel runtime.
DATABASE_URL=

# Server-only. Restaurant Management guest receipt email (Issue #27).
# Resend HTTP API. Never prefix with VITE_. Mark Sensitive on Vercel; runtime only.
# If either is unset, sendOrderReceiptEmail returns "Email not configured".
RESEND_API_KEY=
RECEIPT_EMAIL_FROM=
