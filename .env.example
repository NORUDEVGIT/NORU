# Copy to .env / .env.local. Do not commit secret values.
# Never prefix SUPABASE_SERVICE_ROLE_KEY with VITE_.

SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Required for platform-admin server functions.
SUPABASE_SERVICE_ROLE_KEY=

# drizzle-kit only. Direct Postgres URL; not used by the Vite app.
DATABASE_URL=
